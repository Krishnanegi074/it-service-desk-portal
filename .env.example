# Optional. When omitted, development uses temporary in-memory storage.
# Example: postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=

# Explicit runtime identity. Use development locally, staging for previews, and
# production only for the public environment. APP_VERSION should be the commit SHA.
APP_ENV=development
APP_VERSION=local

# Optional. P1 and P2 incidents use a safe local dry-run when omitted.
OUTBOUND_WEBHOOK_URL=

# Required for production authentication. Find these in the Supabase project
# Connect dialog. The publishable key is designed for browser use; never put a
# service-role key in a NEXT_PUBLIC variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Local development only. Production always ignores this bypass.
AUTH_DEMO_MODE=true
# Optional local demo role: engineer (default) or admin.
AUTH_DEMO_ROLE=admin

# Incidents older than this are eligible for an explicit administrator purge.
# Accepted range: 30-3650 days.
INCIDENT_RETENTION_DAYS=365

# Optional Jira Service Management delivery. When these are omitted, incidents
# remain in a visible pending state and can be sent after configuration.
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_SERVICE_DESK_ID=
JIRA_REQUEST_TYPE_ID=

# Required to accept Jira Automation status callbacks at
# /api/integrations/jira/webhook. Send this value in the
# x-triage-webhook-secret header.
JIRA_WEBHOOK_SECRET=

# Optional generic server-error collector. Errors are secret-redacted before
# transmission. The token is sent only as a Bearer authorization header.
ERROR_REPORTING_ENDPOINT=
ERROR_REPORTING_TOKEN=
